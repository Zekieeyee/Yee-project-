    def generate_specific_report(self, report_type: str):
        try:
            res = supabase.table("orders").select("*").execute()
            orders = res.data
        except:
            orders = []

        if "Daily" in report_type:
            report = self.report_generator.generate_daily_report()
            filename = f"daily_report_{datetime.now().strftime('%Y%m%d')}.csv"
        elif "Yearly" in report_type:
            # Yearly report for 2026-2030
            years = list(range(2026, 2031))
            yearly_data = []
            for year in years:
                year_orders = []
                for o in orders:
                    try:
                        o_date = datetime.fromisoformat(o['created_at'].replace('Z', '+00:00'))
                        if o_date.year == year and o.get('status') == 'Completed':
                            year_orders.append(o)
                    except:
                        pass
                total_rev = sum(o.get('total', 0) for o in year_orders)
                total_orders = len(year_orders)
                yearly_data.append({"year": year, "revenue": total_rev, "orders": total_orders})

            filename = f"yearly_report_2026_2030_{datetime.now().strftime('%Y%m%d')}.csv"
            import csv
            with open(filename, 'w', newline='', encoding='utf-8') as f:
                writer = csv.writer(f)
                writer.writerow(["DRIX COFFEE - YEARLY REPORT (2026-2030)"])
                writer.writerow([f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"])
                writer.writerow([])
                writer.writerow(["Year", "Total Revenue", "Total Orders"])
                for data in yearly_data:
                    writer.writerow([data["year"], f"₱{data['revenue']:,.2f}", data["orders"]])
            messagebox.showinfo("Export Complete", f"Yearly report saved to {filename}")
            return
        else:
            filename = f"report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
            report = {"total_orders": len(orders), "total_revenue": sum(o.get('total', 0) for o in orders)}

        self.report_generator.export_report_to_csv(report, filename)

