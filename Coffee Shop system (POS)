    def show_summary(self, method, total_amt):
        if not self.cart: return

        self.root.attributes('-disabled', True)
        transaction_id = self.transaction_manager.begin_transaction()

        summary = ctk.CTkToplevel(self.root)
        summary.geometry("500x750")
        summary.title("Payment Summary")
        summary.attributes("-topmost", True)
        summary.grab_set()

        def on_summary_close():
            self.root.attributes('-disabled', False)
            summary.destroy()

        summary.protocol("WM_DELETE_WINDOW", on_summary_close)

        ctk.CTkLabel(summary, text="PAYMENT SUMMARY", font=("Impact", 28), text_color=self.accent_light).pack(pady=20)

        ref_in = None
        if method == "GCash":
            gcash_f = ctk.CTkFrame(summary, fg_color="#0055ff", corner_radius=10)
            gcash_f.pack(fill="x", padx=40, pady=10)
            ctk.CTkLabel(gcash_f, text="GCASH PAYMENT", font=("Segoe UI", 12, "bold"), text_color="white").pack(pady=5)
            ctk.CTkLabel(gcash_f, text="Drix Coffee Shop", font=("Segoe UI", 14, "bold"), text_color="white").pack()
            ctk.CTkLabel(gcash_f, text="09305158605", font=("Segoe UI", 18, "bold"), text_color="yellow").pack(pady=5)
            ctk.CTkLabel(summary, text="Reference Number:").pack(pady=(10, 0))
            ref_in = ctk.CTkEntry(summary, width=300, height=40, placeholder_text="Enter 13-digit Ref No.")
            ref_in.pack(pady=5)

        list_f = ctk.CTkScrollableFrame(summary, height=200)
        list_f.pack(fill="x", padx=40, pady=10)
        for item in self.cart:
            ctk.CTkLabel(list_f, text=f"{item['qty']}x {item['name']} - ₱{item['total']:,.2f}", anchor="w").pack(
                fill="x")

        ctk.CTkLabel(summary, text=f"TOTAL: ₱{total_amt:,.2f}", font=("Segoe UI", 22, "bold")).pack(pady=10)

        cash_in = None
        change_lbl = None

        if method == "Cash":
            ctk.CTkLabel(summary, text="Cash Received:").pack()
            cash_in = ctk.CTkEntry(summary, width=200, height=40, font=("Arial", 18))
            cash_in.pack(pady=5)
            change_lbl = ctk.CTkLabel(summary, text="Change: ₱0.00", font=("Segoe UI", 18, "bold"),
                                      text_color=self.accent_light)
            change_lbl.pack(pady=5)

            def calc(event=None):
                try:
                    if cash_in and cash_in.winfo_exists():
                        val = float(cash_in.get())
                        if change_lbl and change_lbl.winfo_exists():
                            change_lbl.configure(text=f"Change: ₱{max(0, val - total_amt):,.2f}")
                except:
                    pass

            cash_in.bind("<KeyRelease>", calc)

        def finalize():
            received = total_amt
            change = 0.0
            reference = ""
            if method == "Cash":
                try:
                    if cash_in and cash_in.winfo_exists():
                        received = float(cash_in.get())
                        if received < total_amt:
                            messagebox.showwarning("Payment", "Insufficient cash!", parent=summary)
                            return
                        change = received - total_amt
                    else:
                        return
                except:
                    return
            elif method == "GCash":
                if ref_in and ref_in.winfo_exists():
                    reference = ref_in.get().strip()
                    if not reference:
                        messagebox.showwarning("Payment", "Please enter GCash Reference Number!", parent=summary)
                        return
                else:
                    return

            order_id = random.randint(1000, 9999)
            now = datetime.now().isoformat()
            order_data = {
                "order_id": order_id,
                "items": self.cart.copy(),
                "total": float(total_amt),
                "method": method,
                "received": float(received),
                "change": float(change),
                "reference": reference,
                "status": "Pending",
                "created_at": now
            }

            try:
                supabase.table("orders").insert(order_data).execute()
                self.transaction_manager.commit(transaction_id)
                self.audit_logger.log_action(self.user.get('username', 'cashier'), "PROCESS_PAYMENT",
                                             f"Order #{order_id} - {method} - ₱{total_amt:,.2f}", "SUCCESS")
                self.cart = []
                self.current_customer = ""
                self.update_cart_ui()
                if summary and summary.winfo_exists():
                    summary.destroy()
                self.root.attributes('-disabled', False)
                self.show_receipt(order_data)
            except Exception as e:
                self.transaction_manager.rollback(transaction_id)
                self.audit_logger.log_action(self.user.get('username', 'cashier'), "PROCESS_PAYMENT",
                                             f"Failed: {str(e)}", "ERROR")
                messagebox.showerror("Database Error", f"Failed to save order: {str(e)}", parent=summary)

        confirm_btn = ctk.CTkButton(summary, text="CONFIRM & PRINT RECEIPT", fg_color=self.accent, height=60,
                                    font=("Segoe UI", 16, "bold"), command=finalize)
        confirm_btn.pack(pady=30, padx=40, fill="x")

