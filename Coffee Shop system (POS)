    def apply_search_filter(self):
        """Apply search filter sa transaction logs"""
        search_text = self.search_entry.get().strip()
        if not search_text:
            messagebox.showwarning("Search Error", "Please enter a search keyword.")
            return

        # I-refresh ang view na may search filter
        self.transaction_history_view(
            self.current_category_filter if hasattr(self, 'current_category_filter') else "All",
            self.current_date_filter if hasattr(self, 'current_date_filter') else None,
            search_text
        )

    def clear_search_filter(self):
        """Clear search filter"""
        if hasattr(self, 'search_entry'):
            self.search_entry.delete(0, 'end')

        # I-refresh ang view na walang search filter
        self.transaction_history_view(
            self.current_category_filter if hasattr(self, 'current_category_filter') else "All",
            self.current_date_filter if hasattr(self, 'current_date_filter') else None,
            None
        )

    def clear_date_filter(self):
        """Clear date filter only"""
        if hasattr(self, 'filter_date_from'):
            self.filter_date_from.delete(0, 'end')
        if hasattr(self, 'filter_date_to'):
            self.filter_date_to.delete(0, 'end')

        # I-refresh ang view na walang date filter
        self.transaction_history_view(
            self.current_category_filter if hasattr(self, 'current_category_filter') else "All",
            None,
            self.current_search_text if hasattr(self, 'current_search_text') else None
        )

    def apply_transaction_filter(self):
        """Apply date filter sa transaction logs"""
        from_date = self.filter_date_from.get().strip()
        to_date = self.filter_date_to.get().strip()

        if not from_date and not to_date:
            messagebox.showwarning("Filter Error", "Please enter a date range to filter.")
            return

        # I-validate ang date format
        try:
            if from_date:
                datetime.strptime(from_date, "%Y-%m-%d")
            if to_date:
                datetime.strptime(to_date, "%Y-%m-%d")
        except ValueError:
            messagebox.showerror("Invalid Date", "Please use YYYY-MM-DD format (e.g., 2026-01-15)")
            return

        # I-refresh ang view na may filter
        self.transaction_history_view("All")

    def clear_transaction_filter(self):
        """Clear lahat ng filters"""
        if hasattr(self, 'filter_date_from'):
            self.filter_date_from.delete(0, 'end')
        if hasattr(self, 'filter_date_to'):
            self.filter_date_to.delete(0, 'end')
        if hasattr(self, 'active_filter_label'):
            self.active_filter_label.configure(text="")

        # I-refresh ang view ng walang filter
        self.transaction_history_view("All")

    def filter_today_transactions(self):
        """Filter transactions para sa kasalukuyang araw"""
        today = datetime.now().strftime("%Y-%m-%d")

        if hasattr(self, 'filter_date_from'):
            self.filter_date_from.delete(0, 'end')
            self.filter_date_from.insert(0, today)
        if hasattr(self, 'filter_date_to'):
            self.filter_date_to.delete(0, 'end')
            self.filter_date_to.insert(0, today)
        if hasattr(self, 'active_filter_label'):
            self.active_filter_label.configure(text=f"📅 Filter: {today}")

        # I-refresh ang view na may filter
        self.transaction_history_view("All", today)


