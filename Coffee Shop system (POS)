class BusinessIntelligence:
    def __init__(self):
        self.cache = {}

    def get_sales_insights(self, orders: List[Dict]) -> Dict:
        insights = {
            "peak_hours": self.analyze_peak_hours(orders),
            "best_selling_products": self.get_best_sellers(orders),
            "customer_retention": self.calculate_retention_rate(orders),
            "average_order_value": self.calculate_aov(orders),
            "sales_trend": self.calculate_trend(orders)
        }
        return insights

    def analyze_peak_hours(self, orders: List[Dict]) -> Dict:
        hour_counts = defaultdict(int)
        for order in orders:
            try:
                dt = datetime.fromisoformat(order['created_at'].replace('Z', '+00:00'))
                hour_counts[dt.hour] += 1
            except:
                pass

        if hour_counts:
            peak_hour = max(hour_counts, key=hour_counts.get)
            return {
                "peak_hour": peak_hour,
                "peak_hour_orders": hour_counts[peak_hour],
                "hour_distribution": dict(hour_counts)
            }
        return {"peak_hour": None, "peak_hour_orders": 0}

    def get_best_sellers(self, orders: List[Dict]) -> List[tuple]:
        """Get best selling products based on ALL orders (year-to-date)"""
        product_sales = defaultdict(int)
        current_year = datetime.now().year

        for order in orders:
            # I-filter lang ang orders ng current year
            try:
                order_date = datetime.fromisoformat(order['created_at'].replace('Z', '+00:00'))
                if order_date.year == current_year:
                    for item in order.get('items', []):
                        # Kunin ang base product name (alisin ang size)
                        base_name = item.get('raw_name', item['name'].split(' (')[0])
                        product_sales[base_name] += item.get('qty', 0)
            except:
                # Kung hindi ma-parse ang date, isama pa rin
                for item in order.get('items', []):
                    base_name = item.get('raw_name', item['name'].split(' (')[0])
                    product_sales[base_name] += item.get('qty', 0)

        # I-sort at ibalik ang top products
        return sorted(product_sales.items(), key=lambda x: x[1], reverse=True)[:3]  # TOP 3 LANG

    def calculate_retention_rate(self, orders: List[Dict]) -> float:
        customers = set()
        returning_customers = set()
        customer_orders = defaultdict(list)

        for order in orders:
            if order.get('items'):
                customer = order['items'][0].get('customer', 'Guest')
                if customer != 'Guest':
                    customers.add(customer)
                    customer_orders[customer].append(order)

        for customer, cust_orders in customer_orders.items():
            if len(cust_orders) > 1:
                returning_customers.add(customer)

        if len(customers) > 0:
            return (len(returning_customers) / len(customers)) * 100
        return 0.0

    def calculate_aov(self, orders: List[Dict]) -> float:
        if not orders:
            return 0.0
        total = sum(o.get('total', 0) for o in orders)
        return total / len(orders)

    def calculate_trend(self, orders: List[Dict]) -> Dict:
        if len(orders) < 2:
            return {"trend": "stable", "percentage": 0}

        now = datetime.now()
        recent_orders = [o for o in orders if
                         datetime.fromisoformat(o['created_at'].replace('Z', '+00:00')) > now - timedelta(days=7)]
        previous_orders = [o for o in orders if
                           datetime.fromisoformat(o['created_at'].replace('Z', '+00:00')) <= now - timedelta(days=7)]

        recent_total = sum(o.get('total', 0) for o in recent_orders)
        previous_total = sum(o.get('total', 0) for o in previous_orders)

        if previous_total == 0:
            return {"trend": "up", "percentage": 100 if recent_total > 0 else 0}

        change = ((recent_total - previous_total) / previous_total) * 100

        if change > 5:
            return {"trend": "up", "percentage": change}
        elif change < -5:
            return {"trend": "down", "percentage": abs(change)}
        else:
            return {"trend": "stable", "percentage": change}

    def generate_predictions(self, orders: List[Dict]) -> Dict:
        if len(orders) < 10:
            return {"message": "Need more data for accurate predictions"}

        recent_weeks = defaultdict(float)
        for order in orders:
            try:
                dt = datetime.fromisoformat(order['created_at'].replace('Z', '+00:00'))
                week_key = dt.isocalendar()[1]
                recent_weeks[week_key] += order.get('total', 0)
            except:
                pass

        if len(recent_weeks) >= 2:
            weeks_list = sorted(recent_weeks.items())
            recent_avg = sum(v for _, v in weeks_list[-2:]) / 2
            return {
                "predicted_next_week_sales": recent_avg,
                "confidence": "medium",
                "based_on_weeks": len(weeks_list)
            }

        return {"message": "Insufficient data for prediction"}


class ReportGenerator:
    def __init__(self, app):
        self.app = app

    def generate_daily_report(self, date: datetime = None) -> Dict:
        if date is None:
            date = datetime.now()

        target_date = date.date()
        orders = self.get_orders_for_date(target_date)

        report = {
            "date": target_date.isoformat(),
            "total_orders": len(orders),
            "total_revenue": sum(o.get('total', 0) for o in orders),
            "payment_methods": self.analyze_payment_methods(orders),
            "top_products": self.get_top_products(orders)
        }
        return report

    def get_orders_for_date(self, target_date):
        try:
            res = supabase.table("orders").select("*").execute()
            orders = []
            for o in res.data:
                try:
                    o_date = datetime.fromisoformat(o['created_at'].replace('Z', '+00:00')).date()
                    if o_date == target_date:
                        orders.append(o)
                except:
                    pass
            return orders
        except:
            return []

    def analyze_payment_methods(self, orders: List[Dict]) -> Dict:
        methods = defaultdict(float)
        for order in orders:
            method = order.get('method', 'Unknown')
            methods[method] += 1
        return dict(methods)

    def get_top_products(self, orders: List[Dict], limit: int = 5) -> List[tuple]:
        product_sales = defaultdict(int)
        for order in orders:
            for item in order.get('items', []):
                product_sales[item.get('name', 'Unknown')] += item.get('qty', 0)
        return sorted(product_sales.items(), key=lambda x: x[1], reverse=True)[:limit]

    def export_report_to_csv(self, report: Dict, filename: str):
        import csv
        with open(filename, 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow(["Report Date", report.get('date', 'N/A')])
            writer.writerow(["Total Orders", report.get('total_orders', 0)])
            writer.writerow(["Total Revenue", report.get('total_revenue', 0)])
            writer.writerow([])
            writer.writerow(["Top Products", "Quantity"])
            for product, qty in report.get('top_products', []):
                writer.writerow([product, qty])

        messagebox.showinfo("Export Complete", f"Report saved to {filename}")


