    def restock_item(self, item_name: str):
        """Restock an inventory item"""
        qty = simpledialog.askinteger("Restock", f"Enter quantity to add for {item_name}:",
                                      minvalue=1, maxvalue=1000)
        if qty:
            if item_name in self.inventory_manager.inventory:
                self.inventory_manager.inventory[item_name]['stock'] += qty
                # I-update din sa database
                try:
                    supabase.table("inventory").update({
                        "stock": self.inventory_manager.inventory[item_name]['stock']
                    }).eq("product_name", item_name).execute()
                    print(f"✅ Updated {item_name} stock in database")
                except Exception as e:
                    print(f"❌ Error updating database: {e}")
                messagebox.showinfo("Success", f"Added {qty} units to {item_name}")
                self.audit_logger.log_action(self.user.get('username', ''), "RESTOCK",
                                             f"Restocked {item_name} with {qty} units", "SUCCESS")
                self.inventory_view()

