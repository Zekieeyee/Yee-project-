    @ErrorHandler.safe_operation
    def authenticate(self):
        u = self.security.sanitize_input(self.u_in.get().strip())
        p = self.p_in.get().strip()

        if not u or not p:
            messagebox.showwarning("Required", "Please fill in all fields.")
            return

        try:
            response = supabase.table("Booking System").select("*").eq("username", u).execute()

            if response.data and len(response.data) > 0:
                user_data = response.data[0]
                if user_data.get('password') == p:
                    self.user = user_data
                    self.session_token = self.security.generate_session_token()
                    self.audit_logger.log_action(u, "LOGIN", "Successful login", "SUCCESS")
                    self.workflow.log_shift_start(u, user_data.get('role', 'cashier'))
                    self.main_dashboard()
                else:
                    self.audit_logger.log_action(u, "LOGIN", "Invalid password", "FAILED")
                    messagebox.showerror("Error", "Invalid Username or Password")
            else:
                self.audit_logger.log_action(u, "LOGIN", "User not found", "FAILED")
                messagebox.showerror("Error", "Invalid Username or Password")
        except Exception as e:
            self.audit_logger.log_action(u, "LOGIN", f"Error: {str(e)}", "ERROR")
            messagebox.showerror("Database Error", f"Cannot connect: {str(e)}")

