    def open_custom(self, item, edit_index=None):
        modal = ctk.CTkToplevel(self.root)
        modal.geometry("450x550")
        modal.title("Customize Order")
        modal.attributes("-topmost", True)
        modal.grab_set()

        product_name = item['name'] if edit_index is None else self.cart[edit_index]['raw_name']
        ctk.CTkLabel(modal, text=f"Product: {product_name}", font=("Segoe UI", 20, "bold"),
                     text_color=self.accent_light).pack(pady=20)

        name_in = None
        if not self.current_customer or edit_index is not None:
            ctk.CTkLabel(modal, text="Customer Name:").pack(anchor="w", padx=50)
            name_in = ctk.CTkEntry(modal, width=350)
            if edit_index is not None:
                name_in.insert(0, self.cart[edit_index]['customer'])
            elif self.current_customer:
                name_in.insert(0, self.current_customer)
            name_in.pack(pady=5)

        ctk.CTkLabel(modal, text="Quantity:").pack(anchor="w", padx=50, pady=(10, 0))
        qty_in = ctk.CTkComboBox(modal, values=["1", "2", "3", "4", "5", "10"], width=350)
        qty_in.set(str(self.cart[edit_index]['qty']) if edit_index is not None else "1")
        qty_in.pack(pady=5)

        ctk.CTkLabel(modal, text="Select Size:").pack(anchor="w", padx=50, pady=(10, 0))
        size_var = ctk.StringVar(value="Small")
        if edit_index is not None:
            curr_size = self.cart[edit_index]['name'].split('(')[-1].replace(')', '')
            size_var.set(curr_size)

        for s, p in [("Small", 0), ("Medium", 20), ("Large", 35)]:
            ctk.CTkRadioButton(modal, text=f"{s} (+₱{p})", variable=size_var, value=s).pack(anchor="w", padx=70, pady=5)

        button_frame = ctk.CTkFrame(modal, fg_color="transparent")
        button_frame.pack(pady=30)

        def save_action():
            size = size_var.get()
            add_price = {"Small": 0, "Medium": 20, "Large": 35}[size]
            base = item['price'] if edit_index is None else self.cart[edit_index]['base_unit_price']
            qty = int(qty_in.get())

            if name_in:
                self.current_customer = self.security.sanitize_input(name_in.get()) or "Guest"

            full_display_name = f"{product_name} ({size})"

            for _ in range(qty):
                self.inventory_manager.deduct_stock(product_name, 1, size)

            entry = {
                "name": full_display_name, "raw_name": product_name, "customer": self.current_customer,
                "qty": qty, "base_unit_price": base, "total": (base + add_price) * qty,
                "size": size
            }

            if edit_index is not None:
                self.cart[edit_index] = entry
            else:
                found = False
                for ex in self.cart:
                    if ex['name'] == full_display_name and ex['customer'] == self.current_customer:
                        ex['qty'] += qty
                        ex['total'] = (ex['base_unit_price'] + add_price) * ex['qty']
                        found = True
                        break
                if not found:
                    self.cart.append(entry)

            modal.destroy()
            self.update_cart_ui()
            self.audit_logger.log_action(self.user.get('username', 'cashier'), "ADD_TO_CART",
                                         f"Added {qty}x {product_name} ({size}) for {self.current_customer}", "SUCCESS")

            if edit_index is None:
                self.ask_more()

        confirm_btn = ctk.CTkButton(button_frame, text="✅ CONFIRM", command=save_action,
                                    fg_color=self.accent, text_color="white",
                                    height=45, width=200, font=("Segoe UI", 16, "bold"))
        confirm_btn.pack()

    def print_receipt_to_pdf(self, order):
        receipts_folder = os.path.join(os.path.dirname(os.path.abspath(__file__)), "receipts")
        if not os.path.exists(receipts_folder):
            os.makedirs(receipts_folder)

        filename = f"receipt_{order['order_id']}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
        pdf_path = os.path.join(receipts_folder, filename)

        try:
            c = canvas.Canvas(pdf_path, pagesize=A4)
            width, height = A4

            c.setFont("Helvetica-Bold", 16)
            c.drawString(50, height - 50, "DRIX COFFEE SHOP")
            c.setFont("Helvetica", 10)
            c.drawString(50, height - 70, "Official Receipt")
            c.drawString(50, height - 85, f"Order ID: #{order['order_id']}")
            c.drawString(50, height - 100, f"Date: {order['created_at'][:19]}")
            if order['items']:
                c.drawString(50, height - 115, f"Customer: {order['items'][0]['customer']}")
            c.line(50, height - 125, width - 50, height - 125)

            y_position = height - 145
            c.setFont("Helvetica-Bold", 10)
            c.drawString(50, y_position, "Item")
            c.drawString(300, y_position, "Qty")
            c.drawString(350, y_position, "Price")
            c.drawString(450, y_position, "Total")
            y_position -= 15
            c.setFont("Helvetica", 9)

            for item in order['items']:
                name = item['name'][:30] if len(item['name']) > 30 else item['name']
                c.drawString(50, y_position, name)
                c.drawString(305, y_position, str(item['qty']))
                unit_price = item['total'] / item['qty'] if item['qty'] > 0 else 0
                c.drawString(355, y_position, f"₱{unit_price:.2f}")
                c.drawString(455, y_position, f"₱{item['total']:.2f}")
                y_position -= 15
                if y_position < 50:
                    c.showPage()
                    y_position = height - 50
                    c.setFont("Helvetica", 9)

            c.line(50, y_position - 5, width - 50, y_position - 5)
            y_position -= 20
            c.setFont("Helvetica-Bold", 12)
            c.drawString(350, y_position, f"TOTAL: ₱{order['total']:.2f}")
            y_position -= 20
            c.setFont("Helvetica", 10)
            c.drawString(50, y_position, f"Payment Method: {order['method']}")
            y_position -= 15
            if order['method'] == "GCash" and order.get('reference'):
                c.drawString(50, y_position, f"Reference No: {order['reference']}")
            else:
                c.drawString(50, y_position, f"Paid: ₱{order['received']:.2f}")
                y_position -= 15
                c.drawString(50, y_position, f"Change: ₱{order['change']:.2f}")
            c.line(50, y_position - 5, width - 50, y_position - 5)
            y_position -= 20
            c.setFont("Helvetica-Oblique", 9)
            c.drawString(50, y_position, "Thank you for choosing Drix Coffee Shop!")
            c.save()
            return pdf_path
        except Exception as e:
            print(f"Error creating PDF: {e}")
            alt_path = os.path.join(os.getcwd(), filename)
            c = canvas.Canvas(alt_path, pagesize=A4)
            width, height = A4
            c.setFont("Helvetica-Bold", 16)
            c.drawString(50, height - 50, "DRIX COFFEE SHOP")
            c.setFont("Helvetica", 10)
            c.drawString(50, height - 70, "Official Receipt")
            c.drawString(50, height - 85, f"Order ID: #{order['order_id']}")
            c.drawString(50, height - 100, f"Date: {order['created_at'][:19]}")
            c.drawString(50, height - 115, f"Total: ₱{order['total']:.2f}")
            c.drawString(50, height - 130, f"Method: {order['method']}")
            c.drawString(50, height - 150, "Thank you for choosing Drix!")
            c.save()
            return alt_path

