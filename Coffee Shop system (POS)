    def display_daily_month_graph(self, container, revenue_values, order_values, labels, title_suffix):
        """Display graph para sa buong buwan - WALANG EMOJI"""

        # FIXED Y LIMIT
        y_max_limit = 6000
        target = 5000

        # Create figure
        fig, ax1 = plt.subplots(figsize=(16, 7), dpi=100)
        fig.patch.set_facecolor('#121212')
        ax1.set_facecolor('#121212')

        # Bar chart for revenue
        max_revenue = max(revenue_values) if revenue_values else 0
        color = '#1DB954' if max_revenue > 0 else '#FF6B35'
        bars = ax1.bar(labels, revenue_values, color=color, width=0.8, alpha=0.8, label='Revenue (₱)')

        # Add value labels
        for bar, value in zip(bars, revenue_values):
            if value > 0:
                height = bar.get_height()
                percentage = (value / target) * 100
                label_y = height + (y_max_limit * 0.01)
                ax1.text(bar.get_x() + bar.get_width() / 2., label_y,
                         f'₱{value:,.0f}\n({percentage:.1f}%)',
                         ha='center', va='bottom', color='white', fontsize=7, fontweight='bold')

        ax1.set_xlabel('Day of Month', color='white', fontsize=12)
        ax1.set_ylabel('Revenue (₱)', color='white', fontsize=12)
        ax1.tick_params(axis='x', colors='gray', labelsize=8, rotation=90)
        ax1.tick_params(axis='y', colors='gray', labelsize=9)
        ax1.set_ylim(0, y_max_limit)

        # Line chart for order count
        ax2 = ax1.twinx()
        ax2.set_ylabel('Number of Orders', color='#FFD700', fontsize=12)
        ax2.plot(labels, order_values, color='#FFD700', marker='o', linewidth=1.5, markersize=4, label='Orders')
        ax2.tick_params(axis='y', colors='#FFD700', labelsize=9)
        max_orders = max(order_values) if order_values else 0
        ax2.set_ylim(0, max_orders + 3 if max_orders > 0 else 10)

        # Title
        ax1.set_title(f"Daily Sales - {title_suffix}", color="white", fontname="Century Gothic", fontsize=14,
                      fontweight='bold')

        # TARGET LINE - WALANG EMOJI
        ax1.axhline(y=target, color='#FFD700', linestyle='--', linewidth=2, alpha=0.9,
                    label=f'TARGET: ₱{target:,.0f}', zorder=1)

        # Add target label
        ax1.text(len(labels) - 2, target + 200, f'Target: ₱{target:,.0f}',
                 color='#FFD700', fontsize=9, fontweight='bold', ha='right',
                 bbox=dict(boxstyle='round,pad=0.3', facecolor='#1A1A1A', alpha=0.8))

        # Average lines
        if revenue_values and any(v > 0 for v in revenue_values):
            positive_revenue = [v for v in revenue_values if v > 0]
            if positive_revenue:
                avg_revenue = sum(positive_revenue) / len(positive_revenue)
                ax1.axhline(y=avg_revenue, color='#00CED1', linestyle=':', linewidth=1.5, alpha=0.7,
                            label=f'Avg Revenue: ₱{avg_revenue:,.0f}')

        if order_values and any(v > 0 for v in order_values):
            positive_orders = [v for v in order_values if v > 0]
            if positive_orders:
                avg_orders = sum(positive_orders) / len(positive_orders)
                ax2.axhline(y=avg_orders, color='#FF6347', linestyle=':', linewidth=1.5, alpha=0.7,
                            label=f'Avg Orders: {avg_orders:.1f}')

        # Legends
        lines1, labels1 = ax1.get_legend_handles_labels()
        lines2, labels2 = ax2.get_legend_handles_labels()
        ax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', facecolor='#121212',
