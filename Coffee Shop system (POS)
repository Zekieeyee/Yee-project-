    def load_inventory(self):
        try:
            print("🔄 Loading inventory from Supabase...")
            res = supabase.table("inventory").select("*").execute()

            print(f"📊 Raw response from Supabase: {res.data}")

            if res.data:
                self.inventory = {}  # I-clear muna ang existing
                for item in res.data:
                    self.inventory[item['product_name']] = item
                print(f"📦 Loaded {len(self.inventory)} inventory items from database")

                # I-print lahat ng items para makita
                for name in self.inventory.keys():
                    print(f"   - {name}")
            else:
                print("⚠️ Inventory table is empty, initializing default inventory...")
                self.initialize_default_inventory()
                self.save_inventory_to_db()
        except Exception as e:
            print(f"⚠️ Error loading inventory: {e}")
            print("Initializing default inventory...")
            self.initialize_default_inventory()
            self.save_inventory_to_db()

    def save_inventory_to_db(self):
        """Save default inventory to Supabase"""
        try:
            for name, data in self.inventory.items():
                # Check if item already exists
                existing = supabase.table("inventory").select("*").eq("product_name", name).execute()
                if not existing.data:
                    # Insert new item
                    supabase.table("inventory").insert({
                        "product_name": name,
                        "stock": data['stock'],
                        "unit": data['unit'],
                        "reorder_point": data.get('reorder_point', 10)
                    }).execute()
                    print(f"✅ Added {name} to inventory database")
                else:
                    # Update existing
                    supabase.table("inventory").update({
                        "stock": data['stock'],
                        "unit": data['unit'],
                        "reorder_point": data.get('reorder_point', 10)
                    }).eq("product_name", name).execute()
                    print(f"✅ Updated {name} in inventory database")
            print("✅ Inventory saved to Supabase successfully!")
        except Exception as e:
            print(f"❌ Error saving inventory to database: {e}")

