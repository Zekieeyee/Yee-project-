        elif hasattr(self, 'filter_date_from') and self.filter_date_from.get():
            try:
                date_from = datetime.strptime(self.filter_date_from.get(), "%Y-%m-%d").date()
                date_to = date_from
            except:
                pass

        # Update active filters display
        active_filters_list = []
        if date_from and date_to:
            if date_from == date_to:
                active_filters_list.append(f"Date: {date_from}")
            else:
                active_filters_list.append(f"Date: {date_from} to {date_to}")

        if search_text:
            active_filters_list.append(
                f"Search: '{search_text}' ({self.search_by.get() if hasattr(self, 'search_by') else 'Customer Name'})")

        if filter_cat != "All":
            active_filters_list.append(f"Category: {filter_cat}")

        if active_filters_list:
            self.active_filters_label.configure(text="Active Filters: " + " | ".join(active_filters_list),
                                                text_color="#FFD700")
        else:
            self.active_filters_label.configure(text="Active Filters: None (Showing all transactions)",
                                                text_color="#888")

        for o in orders:
            # Apply date filter
            if date_from and date_to:
                try:
                    o_date = datetime.fromisoformat(o['created_at'].replace('Z', '+00:00')).date()
                    if not (date_from <= o_date <= date_to):
                        continue
                except:
                    continue

            # Apply search filter
            if search_text:
                search_lower = search_text.lower()
                found = False
                search_by = self.search_by.get() if hasattr(self, 'search_by') else "Customer Name"

                if search_by == "Customer Name":
                    customer = o['items'][0]['customer'] if o.get('items') else "Guest"
                    if search_lower in customer.lower():
                        found = True
                elif search_by == "Order ID":
                    if search_lower in str(o.get('order_id', '')):
                        found = True
                elif search_by == "Product Name":
                    for item in o.get('items', []):
                        if search_lower in item.get('name', '').lower():
                            found = True
                            break
                elif search_by == "Payment Method":
                    if search_lower in o.get('method', '').lower():
                        found = True

                if not found:
                    continue

            # Apply category filter
            order_items_filtered = []
            has_selected_category = False

            for item in o.get('items', []):
                item_cat = "Coffee"
                raw_n = item.get('raw_name', item['name'].split(' (')[0])
                for m_item in menu:
                    if m_item['name'] == raw_n:
                        item_cat = m_item.get('cat', 'Coffee')
                        break

                if filter_cat == "All" or item_cat == filter_cat:
                    has_selected_category = True
                    order_items_filtered.append(f"{item.get('qty', 1)}x {item['name']}")

            if not has_selected_category:
                continue

            filtered_orders.append(o)

            f = ctk.CTkFrame(sc, fg_color="#121212", height=65, corner_radius=8, border_width=1, border_color="#222")
            f.pack(fill="x", pady=3)
            f.pack_propagate(False)

            created_date = o.get('created_at', '')
            display_date = created_date[:16] if created_date else "Unknown"
            ctk.CTkLabel(f, text=display_date, font=("Segoe UI", 10)).place(relx=0.02, rely=0.5, anchor="w")
            cust = o['items'][0]['customer'] if o.get('items') else "Guest"
            ctk.CTkLabel(f, text=cust, font=("Segoe UI", 11, "bold")).place(relx=0.18, rely=0.5, anchor="w")
            details_str = ", ".join(order_items_filtered)
            if len(details_str) > 60:
                details_str = details_str[:57] + "..."
            ctk.CTkLabel(f, text=details_str, font=("Segoe UI", 11)).place(relx=0.45, rely=0.5, anchor="w")
            ctk.CTkLabel(f, text=f"₱{o.get('total', 0):,.2f}", font=("Segoe UI", 13, "bold"),
                         text_color=self.accent_light).place(relx=0.90, rely=0.5, anchor="w")

        # Show count of filtered transactions
        total_revenue = sum(o.get('total', 0) for o in filtered_orders)
        count_label = ctk.CTkLabel(self.content,
                                   text=f"📋 Showing {len(filtered_orders)} transactions | Total Revenue: ₱{total_revenue:,.2f}",
                                   font=("Segoe UI", 11), text_color="gray")
        count_label.pack(pady=5)

    # ========================================================================
    # GRAPH DISPLAY METHODS
    # ========================================================================

    def display_real_graph(self, container, orders, report_type):
        """Display graph para sa monthly report"""

        now = datetime.now()
        y_max_limit = 35000

        if report_type == "Daily":
            # Daily: Ipakita ang BUONG BUWAN (Day 1 hanggang last day)
            current_month = now.month
            current_year = now.year
            last_day = calendar.monthrange(current_year, current_month)[1]

            labels = [f"Day {i}" for i in range(1, last_day + 1)]

            revenue_values = [0] * last_day
            order_values = [0] * last_day

            for o in orders:
                try:
                    o_date = datetime.fromisoformat(o['created_at'].replace('Z', '+00:00'))
                    if o_date.year == current_year and o_date.month == current_month:
                        day_index = o_date.day - 1
                        if 0 <= day_index < last_day:
                            revenue_values[day_index] += o.get('total', 0)
                            order_values[day_index] += 1
                except:
                    pass

            title = f"Daily Sales - {now.strftime('%B %Y')}"

        else:  # Monthly
            current_year = now.year
            labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

            revenue_values = [0] * 12
            order_values = [0] * 12

            for i, month_label in enumerate(labels):
                month_num = i + 1
                month_start = datetime(current_year, month_num, 1)
                if month_num == 12:
                    month_end = datetime(current_year, 12, 31)
                else:
                    month_end = datetime(current_year, month_num + 1, 1) - timedelta(days=1)

                for o in orders:
                    try:
                        o_date = datetime.fromisoformat(o['created_at'].replace('Z', '+00:00')).date()
                        if month_start.date() <= o_date <= month_end.date():
                            revenue_values[i] += o.get('total', 0)
                            order_values[i] += 1
                    except:
                        pass

            title = f"Monthly Sales - {current_year}"

        # Create figure with two y-axes
        fig, ax1 = plt.subplots(figsize=(14, 6), dpi=100)
        fig.patch.set_facecolor('#121212')
        ax1.set_facecolor('#121212')

        # Bar chart for revenue
        max_rev = max(revenue_values) if revenue_values else 0
        color = '#1DB954' if max_rev > 0 else '#FF6B35'
        bars = ax1.bar(labels, revenue_values, color=color, width=0.8 if report_type == "Daily" else 0.6, alpha=0.8,
                       label='Revenue (₱)')

        # Add value labels
        for bar, value in zip(bars, revenue_values):
            if value > 0:
                height = bar.get_height()
                offset = y_max_limit * 0.02
                if report_type == "Daily" and len(labels) > 20:
                    ax1.text(bar.get_x() + bar.get_width() / 2., height + offset,
                             f'₱{value:,.0f}', ha='center', va='bottom', color='white', fontsize=6, rotation=90)
                else:
                    ax1.text(bar.get_x() + bar.get_width() / 2., height + offset,
                             f'₱{value:,.0f}', ha='center', va='bottom', color='white', fontsize=8)

        ax1.set_xlabel('Day of Month' if report_type == "Daily" else 'Month', color='white')
        ax1.set_ylabel('Revenue (₱)', color='white')
        ax1.tick_params(axis='x', colors='gray', labelsize=8 if report_type == "Daily" and len(labels) > 20 else 9,
                        rotation=90 if report_type == "Daily" and len(labels) > 20 else 45)
        ax1.tick_params(axis='y', colors='gray', labelsize=9)
        ax1.set_ylim(0, y_max_limit)

        # Line chart for order count (right y-axis)
        ax2 = ax1.twinx()
        ax2.set_ylabel('Number of Orders', color='#FFD700')
        ax2.plot(labels, order_values, color='#FFD700', marker='o', linewidth=2,
                 markersize=4 if report_type == "Daily" and len(labels) > 20 else 6, label='Orders')
        ax2.tick_params(axis='y', colors='#FFD700', labelsize=9)
        ax2.set_ylim(0, max(order_values) + 2 if max(order_values) > 0 else 5)

        ax1.set_title(title, color="white", fontname="Century Gothic", fontsize=12, fontweight='bold')
        ax1.axhline(y=35000, color='#FFD700', linestyle='--', linewidth=1, alpha=0.5, label='Target: ₱35,000')

        # Average lines
        if revenue_values and any(v > 0 for v in revenue_values):
            positive_revenue = [v for v in revenue_values if v > 0]
            if positive_revenue:
                avg_revenue = sum(positive_revenue) / len(positive_revenue)
                ax1.axhline(y=avg_revenue, color='#00CED1', linestyle=':', linewidth=1.5, alpha=0.7,
                            label=f'Avg Revenue: ₱{avg_revenue:,.0f}')

        if order_values and any(v > 0 for v in order_values):
            positive_orders = [v for v in order_values if v > 0]
            if positive_orders:
                avg_orders = sum(positive_orders) / len(positive_orders)
                ax2.axhline(y=avg_orders, color='#FF6347', linestyle=':', linewidth=1.5, alpha=0.7,
                            label=f'Avg Orders: {avg_orders:.1f}')

        lines1, labels1 = ax1.get_legend_handles_labels()
        lines2, labels2 = ax2.get_legend_handles_labels()
        ax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', facecolor='#121212', labelcolor='white',
                   fontsize=8)

        ax1.grid(axis='y', linestyle='--', alpha=0.1, color='gray')
        for spine in ax1.spines.values():
            spine.set_visible(False)

        fig.tight_layout()
        canvas = FigureCanvasTkAgg(fig, master=container)
        canvas.draw()
        canvas.get_tk_widget().pack(fill="both", expand=True, padx=20, pady=20)


