    def display_yearly_graph(self, container, revenue_data, order_count_data, growth_rates, years):
        """Display yearly graph - FIXED TARGET AT 100,000"""

        labels = [str(year) for year in years]
        revenue_values = [revenue_data[year] for year in years]
        order_values = [order_count_data[year] for year in years]

        # FIXED Y LIMIT PARA MAKITA ANG 100,000 TARGET
        y_max_limit = 120000  # 120,000 para may space sa taas ng target line

        # I-set ang target sa 100,000
        target = 100000

        # Create figure with larger size
        fig, ax1 = plt.subplots(figsize=(16, 8), dpi=120)
        fig.patch.set_facecolor('#121212')
        ax1.set_facecolor('#121212')

        # Bar chart for revenue
        color = '#1DB954' if max(revenue_values) > 0 else '#FF6B35'
        bars = ax1.bar(labels, revenue_values, color=color, width=0.5, alpha=0.85, label='Revenue (₱)', zorder=2)

        # Add value labels
        for bar, value in zip(bars, revenue_values):
            if value > 0:
                height = bar.get_height()
                percentage = (value / target) * 100
                label_y = height + (y_max_limit * 0.01)
                ax1.text(bar.get_x() + bar.get_width() / 2., label_y,
                         f'₱{value:,.0f}\n({percentage:.1f}%)',
                         ha='center', va='bottom', color='white', fontsize=9, fontweight='bold')

        ax1.set_xlabel('Year', color='white', fontsize=13, fontweight='bold')
        ax1.set_ylabel('Revenue (₱)', color='white', fontsize=13, fontweight='bold')
        ax1.tick_params(axis='x', colors='gray', labelsize=12)
        ax1.tick_params(axis='y', colors='gray', labelsize=11)
        ax1.set_ylim(0, y_max_limit)

        # Line chart for order count
        ax2 = ax1.twinx()
        ax2.set_ylabel('Number of Orders', color='#FFD700', fontsize=13, fontweight='bold')
        ax2.plot(labels, order_values, color='#FFD700', marker='o', linewidth=3, markersize=12, label='Orders',
                 zorder=3)
        ax2.tick_params(axis='y', colors='#FFD700', labelsize=11)
        max_orders = max(order_values) if order_values else 0
        ax2.set_ylim(0, max_orders + (max_orders * 0.2) + 5 if max_orders > 0 else 20)

        # Add order count labels
        for i, value in enumerate(order_values):
            if value > 0:
                ax2.annotate(str(value), (labels[i], value), textcoords="offset points", xytext=(0, 12),
                             ha='center', color='#FFD700', fontsize=11, fontweight='bold')

        # Title
        ax1.set_title(f"Yearly Sales Report ({years[0]} - {years[-1]})", color="white",
                      fontname="Century Gothic", fontsize=18, fontweight='bold', pad=20)

        # TARGET LINE - WALANG EMOJI
        ax1.axhline(y=target, color='#FFD700', linestyle='--', linewidth=2.5, alpha=0.9,
                    label=f'TARGET: ₱{target:,.0f}', zorder=1)

        # Add target label
        ax1.text(len(labels) - 0.5, target + 2000, f'Target: ₱{target:,.0f}',
                 color='#FFD700', fontsize=10, fontweight='bold', ha='right',
                 bbox=dict(boxstyle='round,pad=0.3', facecolor='#1A1A1A', alpha=0.8))

        # Average line for revenue
        if revenue_values and any(v > 0 for v in revenue_values):
            positive_revenue = [v for v in revenue_values if v > 0]
            if positive_revenue:
                avg_revenue = sum(positive_revenue) / len(positive_revenue)
                ax1.axhline(y=avg_revenue, color='#00CED1', linestyle=':', linewidth=2, alpha=0.8,
                            label=f'Avg Revenue: ₱{avg_revenue:,.0f}', zorder=1)

        # Average line for orders
        if order_values and any(v > 0 for v in order_values):
            positive_orders = [v for v in order_values if v > 0]
            if positive_orders:
                avg_orders = sum(positive_orders) / len(positive_orders)
                ax2.axhline(y=avg_orders, color='#FF6347', linestyle=':', linewidth=2, alpha=0.8,
                            label=f'Avg Orders: {avg_orders:.1f}', zorder=1)

        # Legends
        lines1, labels1 = ax1.get_legend_handles_labels()
        lines2, labels2 = ax2.get_legend_handles_labels()
        ax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', facecolor='#121212',
                   labelcolor='white', fontsize=11, framealpha=0.9, edgecolor='#333')

        # Grid
        ax1.grid(axis='y', linestyle='--', alpha=0.15, color='gray', linewidth=0.8)
        for spine in ax1.spines.values():
            spine.set_visible(False)

        # Adjust layout
        fig.tight_layout(pad=2.0)

        canvas = FigureCanvasTkAgg(fig, master=container)
        canvas.draw()
        canvas.get_tk_widget().pack(fill="both", expand=True, padx=10, pady=10)

