            else:
                btn.configure(fg_color="transparent", text_color="#888", font=("Segoe UI", 12, "normal"))

        try:
            res = supabase.table("orders").select("*").execute()
            orders = res.data
        except Exception as e:
            print(f"Error loading orders: {e}")
            orders = []

        now = datetime.now()
        filtered_orders = []
        title_suffix = ""
        previous_revenue = 0
        current_revenue = 0

        # I-filter ang orders base sa report type
        if report_type == "Daily":
            # Daily: Ipakita ang BUONG BUWAN (Day 1 hanggang last day)
            current_month = now.month
            current_year = now.year

            # Kunin ang last day ng buwan
            last_day = calendar.monthrange(current_year, current_month)[1]

            # Gumawa ng labels mula Day 1 hanggang last day
            labels = [f"Day {i}" for i in range(1, last_day + 1)]

            title_suffix = f"{now.strftime('%B %Y')} (Day 1 - {last_day})"

            # Data arrays para sa bawat araw
            revenue_values = [0] * last_day
            order_values = [0] * last_day
            filtered_orders = []

            # I-loop ang bawat order at i-assign sa tamang araw
            for o in orders:
                try:
                    o_date = datetime.fromisoformat(o['created_at'].replace('Z', '+00:00'))
                    if o_date.year == current_year and o_date.month == current_month:
                        day_index = o_date.day - 1
                        if 0 <= day_index < last_day:
                            revenue_values[day_index] += o.get('total', 0)
                            order_values[day_index] += 1
                            filtered_orders.append(o)
                except:
                    pass

            current_revenue = sum(revenue_values)
            total_orders = sum(order_values)

            # Compute percent change from PREVIOUS MONTH (same month last year or last month)
            # Kunin ang previous month data para sa growth comparison
