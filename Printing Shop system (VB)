    Private Sub PrintDocument1_PrintPage(sender As Object, e As PrintPageEventArgs) Handles PrintDocument1.PrintPage

        Static currentRowIndex As Integer = 0

        Dim printFont As New Font("Consolas", 8, FontStyle.Regular)
        Dim headerFont As New Font("Consolas", 8, FontStyle.Bold)
        Dim titleFont As New Font("Consolas", 10, FontStyle.Bold)

        Dim startX As Integer = 20
        Dim startY As Integer = 40
        Dim lineHeight As Integer = 14
        Dim currentY As Integer = startY

        ' ===== HEADER =====
        If currentRowIndex = 0 Then
            e.Graphics.DrawString("PRINTING SHOP", titleFont, Brushes.Black, startX, currentY)
            currentY += 18
            e.Graphics.DrawString("SALES REPORT", headerFont, Brushes.Black, startX, currentY)
            currentY += 18
            e.Graphics.DrawString($"Period: {dtpFromDate.Value:yyyy-MM-dd} to {dtpToDate.Value:yyyy-MM-dd}", printFont, Brushes.Black, startX, currentY)
            currentY += 14

            ' Compute grand total
            Dim grandTotal As Decimal = 0
            For Each row As DataGridViewRow In dgvSales.Rows
                If Not row.IsNewRow AndAlso row.Cells("TotalAmount").Value IsNot Nothing Then
                    grandTotal += Convert.ToDecimal(row.Cells("TotalAmount").Value)
                End If
            Next

            e.Graphics.DrawString($"Total Sales: ₱{grandTotal:N2}", headerFont, Brushes.Black, startX, currentY)
            currentY += 20

            ' Column Headers - gaya ng sa DataGridView mo
            Dim headers As String = "ID    Service              Size     Qty   Price   Total     Date       Time     Paid      Change    Order"
            e.Graphics.DrawString(headers, headerFont, Brushes.Black, startX, currentY)
            currentY += 12
            e.Graphics.DrawString(New String("-", 105), printFont, Brushes.Black, startX, currentY)
            currentY += 12
        Else
            currentY = startY
        End If

        ' ===== PRINT ROWS =====
        For i As Integer = currentRowIndex To dgvSales.Rows.Count - 1
            Dim row As DataGridViewRow = dgvSales.Rows(i)
            If Not row.IsNewRow Then
                ' Kunin ang values
                Dim id As String = If(row.Cells("ID").Value IsNot Nothing, row.Cells("ID").Value.ToString(), "")
                Dim service As String = If(row.Cells("ServiceType").Value IsNot Nothing, row.Cells("ServiceType").Value.ToString(), "")
                If service.Length > 18 Then service = service.Substring(0, 15) & "..."

                Dim size As String = If(row.Cells("Size").Value IsNot Nothing, row.Cells("Size").Value.ToString(), "")
                If size.Length > 8 Then size = size.Substring(0, 5) & "..."

                Dim qty As String = If(row.Cells("Quantity").Value IsNot Nothing, row.Cells("Quantity").Value.ToString(), "0")
                Dim price As String = FormatCurrency(row.Cells("Price").Value)
                Dim total As String = FormatCurrency(row.Cells("TotalAmount").Value)
                Dim dateVal As String = FormatDateShort(row.Cells("SaleDate").Value)
                Dim timeVal As String = FormatTimeShort(row.Cells("SaleTime").Value)
                Dim paid As String = FormatCurrency(row.Cells("AmountPaid").Value)
                Dim change As String = FormatCurrency(row.Cells("ChangeAmount").Value)
                Dim orderID As String = If(row.Cells("OrderID").Value IsNot Nothing, row.Cells("OrderID").Value.ToString(), "")

                ' I-format ang bawat column na may fixed spacing
                Dim line As String = String.Format("{0,-5} {1,-20} {2,-8} {3,-5} {4,-7} {5,-9} {6,-10} {7,-7} {8,-9} {9,-8} {10,-8}",
                                                    id, service, size, qty, price, total, dateVal, timeVal, paid, change, orderID)

                e.Graphics.DrawString(line, printFont, Brushes.Black, startX, currentY)
                currentY += lineHeight

                ' Page break
                If currentY > e.PageBounds.Height - 60 Then
                    currentRowIndex = i + 1
                    e.HasMorePages = True
                    Return
                End If
            End If
        Next

        ' ===== FOOTER =====
        currentY += 10
        e.Graphics.DrawString(New String("-", 105), printFont, Brushes.Black, startX, currentY)
        currentY += 15

        ' Grand Total
        Dim finalGrandTotal As Decimal = 0
        For Each row As DataGridViewRow In dgvSales.Rows
            If Not row.IsNewRow AndAlso row.Cells("TotalAmount").Value IsNot Nothing Then
                finalGrandTotal += Convert.ToDecimal(row.Cells("TotalAmount").Value)
            End If
        Next

        Dim totalText As String = String.Format("{0,85} {1,12}", "GRAND TOTAL:", $"₱{finalGrandTotal:N2}")
        e.Graphics.DrawString(totalText, headerFont, Brushes.Black, startX, currentY)
        currentY += 15

        e.Graphics.DrawString($"Total Transactions: {dgvSales.Rows.Count}", printFont, Brushes.Black, startX, currentY)
        currentY += 15

        e.Graphics.DrawString($"Printed: {DateTime.Now:yyyy-MM-dd HH:mm:ss}", printFont, Brushes.Black, startX, currentY)

        ' Reset
        currentRowIndex = 0
        e.HasMorePages = False
    End Sub
    Private Function FormatCurrency(value As Object) As String
        If value Is Nothing OrElse IsDBNull(value) Then Return "0.00"
        Dim num As Decimal
        If Decimal.TryParse(value.ToString(), num) Then
            Return num.ToString("0.00")
        End If
        Return "0.00"
    End Function

    Private Function FormatDateShort(value As Object) As String
        If value Is Nothing OrElse IsDBNull(value) Then Return ""
        Dim dt As DateTime
        If DateTime.TryParse(value.ToString(), dt) Then
            Return dt.ToString("MM/dd/yy")
        End If
        Return value.ToString()
    End Function

    Private Function FormatTimeShort(value As Object) As String
        If value Is Nothing OrElse IsDBNull(value) Then Return ""
        Dim timeStr As String = value.ToString()
        If timeStr.Length >= 5 Then
            Return timeStr.Substring(0, 5)
        End If
        Return timeStr
    End Function

