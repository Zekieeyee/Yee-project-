    Private Sub btnAddToCart_Click(sender As Object, e As EventArgs) Handles btnAddToCart.Click

        If Not grpCart.Visible Then
            ShowNotification("Please click CREATE CART first", "warning")
            Return
        End If

        If cmbServiceType.Text = "" Or cmbServiceType.Text = "Type of Service" Then
            ShowNotification("Please select a valid service type", "warning")
            cmbServiceType.Focus()
            Return
        End If

        If cmbSize.Text = "" Or cmbSize.Text = "Select Size" Then
            ShowNotification("Please select a size", "warning")
            cmbSize.Focus()
            Return
        End If

        If numQuantity.Value <= 0 Then
            ShowNotification("Quantity must be greater than 0", "warning")
            numQuantity.Focus()
            Return
        End If

        Dim price As Decimal = Val(txtPrice.Text)
        If price <= 0 Then
            ShowNotification("Price not available for this service/size", "warning")
            Return
        End If

        ' ADD TO CART - 5 values lang (WALA NG TIME)
        Dim total As Decimal = numQuantity.Value * price

        ' TAMA: 5 values para sa 5 columns
        cartItems.Rows.Add(cmbServiceType.Text, cmbSize.Text, numQuantity.Value, price, total)
        UpdateCartTotal()

        ' CLEAR FIELDS
        cmbServiceType.SelectedIndex = -1
        cmbSize.Items.Clear()
        cmbSize.Text = "Select Size"
        numQuantity.Value = 1
        txtPrice.Clear()

        cmbServiceType.Focus()

        ShowNotification("Item added to cart!", "success")
    End Sub
    Private Sub UpdateCartTotal()
        cartTotal = 0
        For Each row As DataRow In cartItems.Rows
            cartTotal += Convert.ToDecimal(row("Total"))
        Next
        lblCartTotal.Text = "₱ " & cartTotal.ToString("N2")
        CalculateChange()

        ' I-enable ang Done button kung may laman ang cart
        btnDone.Enabled = (cartItems.Rows.Count > 0)
    End Sub
    Private Sub CalculateChange()
        Dim amountPaid As Decimal = 0
        If Decimal.TryParse(txtReceiveMoney.Text, amountPaid) Then
            Dim change As Decimal = amountPaid - cartTotal
            If change >= 0 Then
                lblChange.Text = "₱ " & change.ToString("N2")
                lblChange.ForeColor = Color.Green
            Else
                lblChange.Text = "₱ " & change.ToString("N2") & " (kulang)"
                lblChange.ForeColor = Color.Red
            End If
        Else
            lblChange.Text = "₱ 0.00"
        End If
    End Sub
    Private Sub txtReceiveMoney_TextChanged(sender As Object, e As EventArgs) Handles txtReceiveMoney.TextChanged
        CalculateChange()
    End Sub
    Private Sub btnCancel_Click(sender As Object, e As EventArgs) Handles btnCancel.Click

        Dim itemCount As Integer = cartItems.Rows.Count

        If itemCount > 0 Then
            If MessageBox.Show($"Cancel transaction? ({itemCount} item(s) will be cleared).",
                           "Cancel Transaction", MessageBoxButtons.YesNo, MessageBoxIcon.Question) = DialogResult.Yes Then

                cartItems.Clear()
                UpdateCartTotal()
                txtReceiveMoney.Clear()
                lblChange.Text = "₱ 0.00"
                grpCart.Visible = False
                Timer1.Enabled = False  ' Stop ang timer
                lblRunningTime.Visible = False

                ShowNotification("Transaction cancelled", "success")
            End If
        Else
            If MessageBox.Show("Are you sure you want to close the cart?", "Close Cart", MessageBoxButtons.YesNo, MessageBoxIcon.Question) = DialogResult.Yes Then
                grpCart.Visible = False
                Timer1.Enabled = False  ' Stop ang timer
                lblRunningTime.Visible = False
            End If
        End If
    End Sub
    Private Sub btnClearCart_Click(sender As Object, e As EventArgs) Handles btnClearCart.Click

        If cartItems.Rows.Count = 0 Then
            ShowNotification("Cart is already empty", "warning")
            Return
        End If

        If MessageBox.Show($"Clear all {cartItems.Rows.Count} item(s) from cart?",
                           "Confirm Clear", MessageBoxButtons.YesNo, MessageBoxIcon.Question) = DialogResult.Yes Then

            cartItems.Clear()
            UpdateCartTotal()
            txtReceiveMoney.Clear()
            lblChange.Text = "₱ 0.00"

            ShowNotification("Cart cleared", "success")
        End If
    End Sub
    Private Sub btnRemoveFromCart_Click(sender As Object, e As EventArgs) Handles btnRemoveFromCart.Click

        If dgvCart.CurrentRow IsNot Nothing Then
            Dim serviceType As String = dgvCart.CurrentRow.Cells("ServiceType").Value.ToString()
            Dim size As String = dgvCart.CurrentRow.Cells("Size").Value.ToString()

            If MessageBox.Show($"Remove {serviceType} ({size}) from cart?", "Confirm Remove",
                               MessageBoxButtons.YesNo, MessageBoxIcon.Question) = DialogResult.Yes Then

                Dim rowIndex As Integer = dgvCart.CurrentRow.Index
                cartItems.Rows.RemoveAt(rowIndex)
                UpdateCartTotal()

                If cartItems.Rows.Count = 0 Then
                    grpCart.Visible = False
                    Timer1.Enabled = False  ' Stop ang timer
                    txtReceiveMoney.Clear()
                    lblChange.Text = "₱ 0.00"
                End If

                ShowNotification("Item removed from cart", "success")
            End If
        Else
            ShowNotification("Please select an item to remove", "warning")
        End If
    End Sub

