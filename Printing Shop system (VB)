    Private Sub cmbServiceType_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cmbServiceType.SelectedIndexChanged
        LoadSizes(cmbServiceType.Text)
        cmbSize.Items.Clear()

        ' ✅ Photocopy = PHOTO SIZES
        If cmbServiceType.Text = "Photocopy" Then
            cmbSize.Items.AddRange({"1x1", "2x2", "3x3", "3R", "4R"})

            ' ✅ Color Print = DOCUMENT SIZES
        ElseIf cmbServiceType.Text = "Color Print" Then
            cmbSize.Items.AddRange({"Short", "Long", "A4", "Legal"})

            ' ✅ Black & White Print = DOCUMENT SIZES
        ElseIf cmbServiceType.Text = "Black & White Print" Then
            cmbSize.Items.AddRange({"Short", "Long", "A4", "Legal"})

            ' ✅ Tarpaulin
        ElseIf cmbServiceType.Text = "Tarpaulin" Then
            cmbSize.Items.AddRange({"Small", "Medium", "Large"})
        End If

        cmbSize.SelectedIndex = -1
        cmbSize.Text = "Select Size"
        txtPrice.Clear()

    End Sub

