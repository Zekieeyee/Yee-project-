    ' =========================
    ' LOAD ALL SALES (NO DATE FILTER)
    ' =========================
    ' =========================
    ' LOAD ALL SALES (NO DATE FILTER)
    ' =========================
    Private Sub LoadAllSales()
        Try
            Dim sql As String = "SELECT ID, ServiceType, Size, Quantity, Price, TotalAmount, 
                                        SaleDate, 
                                        DATE_FORMAT(SaleTime, '%h:%i:%s %p') AS SaleTime,
                                        AmountPaid, ChangeAmount, OrderID 
                                 FROM Sales 
                                 ORDER BY SaleDate DESC, SaleTime DESC"

            Using cmd As New MySqlCommand(sql, con)
                Dim da As New MySqlDataAdapter(cmd)
                Dim dt As New DataTable()
                da.Fill(dt)

                dgvSales.DataSource = dt
                ComputeReportTotal(dt)

                ' I-format ang column headers
                If dgvSales.Columns.Count > 0 Then
                    dgvSales.Columns("SaleTime").HeaderText = "Time"
                End If

                ' Reset date pickers
                dtpFromDate.Value = New DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)
                dtpToDate.Value = DateTime.Now.Date
            End Using
        Catch ex As Exception
            MessageBox.Show("Error loading all sales: " & ex.Message)
        End Try
    End Sub
    Private Sub btnAllSales_Click(sender As Object, e As EventArgs) Handles btnAllSales.Click
        LoadAllSales()
    End Sub

    ' =========================
    ' LOAD SALES REPORT BY DATE RANGE (From - To)
    ' =========================
    Private Sub LoadSalesReportByDateRange(fromDate As Date, toDate As Date)
        Try
            ' Convert to end of day para kasama ang buong araw ng "to date"
            Dim toDateEnd As Date = toDate.Date.AddDays(1).AddSeconds(-1)

            ' SQL na may formatted time (12-hour format na may am/pm)
            Dim sql As String = "SELECT ID, ServiceType, Size, Quantity, Price, TotalAmount, 
                                        SaleDate, 
                                        DATE_FORMAT(SaleTime, '%h:%i:%s %p') AS SaleTime,
                                        AmountPaid, ChangeAmount, OrderID 
                                 FROM Sales 
                                 WHERE SaleDate BETWEEN @FromDate AND @ToDate 
                                 ORDER BY SaleDate DESC, SaleTime DESC"

            Using cmd As New MySqlCommand(sql, con)
                cmd.Parameters.AddWithValue("@FromDate", fromDate.ToString("yyyy-MM-dd"))
                cmd.Parameters.AddWithValue("@ToDate", toDateEnd.ToString("yyyy-MM-dd"))

                Dim da As New MySqlDataAdapter(cmd)
                Dim dt As New DataTable()
                da.Fill(dt)

                dgvSales.DataSource = dt
                ComputeReportTotal(dt)

                ' I-format ang column headers (optional)
                If dgvSales.Columns.Count > 0 Then
                    dgvSales.Columns("SaleTime").HeaderText = "Time"
                End If

            End Using
        Catch ex As Exception
            MessageBox.Show("Error loading report: " & ex.Message)
        End Try
    End Sub

