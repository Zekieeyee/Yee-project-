    Private Sub dgvSales_CellClick(sender As Object, e As DataGridViewCellEventArgs) Handles dgvSales.CellClick
        If e.RowIndex < 0 Then Exit Sub
        Dim row As DataGridViewRow = dgvSales.Rows(e.RowIndex)

        ' Set selectedID and populate fields
        If Not IsDBNull(row.Cells("ID").Value) Then
            selectedID = Convert.ToInt32(row.Cells("ID").Value)
            cmbServiceType.Text = row.Cells("ServiceType").Value.ToString()
            numQuantity.Value = Convert.ToDecimal(row.Cells("Quantity").Value)
            txtPrice.Text = row.Cells("Price").Value.ToString()
        End If

        ' Check multiple services
        If Not IsDBNull(row.Cells("OrderID").Value) Then
            Dim orderID As Integer = Convert.ToInt32(row.Cells("OrderID").Value)
            CheckOrderServices(orderID)
        End If
    End Sub

    ' =========================
    ' Check Multiple Services
    ' =========================
    Private Sub CheckOrderServices(orderID As Integer)
        Try
            Dim da As New MySqlDataAdapter("SELECT ServiceType, Size, Quantity, Price, TotalAmount FROM Sales WHERE OrderID=@OrderID", con)
            da.SelectCommand.Parameters.AddWithValue("@OrderID", orderID)
            Dim dt As New DataTable
            da.Fill(dt)
            If dt.Rows.Count > 1 Then
                MessageBox.Show("This transaction contains multiple services (" & dt.Rows.Count & ").")
            Else
                MessageBox.Show("This transaction contains only one service.")
            End If
        Catch ex As Exception
            MessageBox.Show(ex.Message)
        End Try
    End Sub
    Private Sub LoadSizes(serviceType As String)
        Try
            cmbSize.Items.Clear()

            Dim cmd As New MySqlCommand("SELECT Size FROM Prices WHERE ServiceType=@service", con)
            cmd.Parameters.AddWithValue("@service", serviceType)

            If con.State = ConnectionState.Open Then con.Close()
            con.Open()

            Dim reader = cmd.ExecuteReader()

            While reader.Read()
                cmbSize.Items.Add(reader("Size").ToString())
            End While

            con.Close()

        Catch ex As Exception
            MessageBox.Show(ex.Message)
        End Try
    End Sub
    ' =========================
    ' Get Price When Combo Changes
