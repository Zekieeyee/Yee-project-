    ' =========================
    ' Filter Function (Daily/Weekly/Monthly)
    ' =========================
    Private Sub FilterSales(Optional dayName As String = "", Optional monthNumber As Integer = 0, Optional startDate As Date? = Nothing, Optional endDate As Date? = Nothing)
        Try
            Dim sql As String = "SELECT * FROM Sales WHERE 1=1"
            Dim cmd As New MySqlCommand()
            cmd.Connection = con

            ' Daily filter by day name
            If dayName <> "" Then
                sql &= " AND DAYNAME(SaleDate) = @Day"
                cmd.Parameters.AddWithValue("@Day", dayName)
            End If

            ' Monthly filter
            If monthNumber > 0 Then
                sql &= " AND MONTH(SaleDate) = @Month"
                cmd.Parameters.AddWithValue("@Month", monthNumber)
            End If

            ' Weekly filter by exact date range
            If startDate.HasValue AndAlso endDate.HasValue Then
                sql &= " AND SaleDate BETWEEN @StartDate AND @EndDate"
                cmd.Parameters.AddWithValue("@StartDate", startDate.Value.ToString("yyyy-MM-dd"))
                cmd.Parameters.AddWithValue("@EndDate", endDate.Value.ToString("yyyy-MM-dd"))
            End If

            cmd.CommandText = sql

            Dim da As New MySqlDataAdapter(cmd)
            Dim dt As New DataTable()
            da.Fill(dt)

            dgvSales.DataSource = Nothing
            dgvSales.Rows.Clear()
            dgvSales.DataSource = dt
            ComputeReportTotal(dt)
        Catch ex As Exception
            MessageBox.Show(ex.Message)
        End Try
    End Sub

