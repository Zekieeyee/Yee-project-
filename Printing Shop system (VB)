    ' =========================
    ' LOAD WEEK SALES (Current Week)
    ' =========================
    Private Sub LoadWeekSales()
        Try
            ' Kunin ang start ng linggo (Monday)
            Dim today As DateTime = DateTime.Now.Date
            Dim diff As Integer = today.DayOfWeek - DayOfWeek.Monday
            If diff < 0 Then diff += 7
            Dim startOfWeek As DateTime = today.AddDays(-diff)

            ' Kunin ang end ng linggo (Sunday)
            Dim endOfWeek As DateTime = startOfWeek.AddDays(6)

            ' I-set ang date pickers
            dtpFromDate.Value = startOfWeek
            dtpToDate.Value = endOfWeek

            ' Load report
            LoadSalesReportByDateRange(startOfWeek, endOfWeek)

            ShowNotification($"Week Sales: {startOfWeek:yyyy-MM-dd} to {endOfWeek:yyyy-MM-dd}", "success")

        Catch ex As Exception
            MessageBox.Show("Error loading week sales: " & ex.Message)
        End Try
    End Sub
    ' =========================
    ' LOAD YEAR SALES (Current Year)
    ' =========================
    Private Sub LoadYearSales()
        Try
            ' Kunin ang start ng taon (January 1)
            Dim startOfYear As DateTime = New DateTime(DateTime.Now.Year, 1, 1)

            ' Kunin ang end ng taon (December 31)
            Dim endOfYear As DateTime = New DateTime(DateTime.Now.Year, 12, 31)

            ' I-set ang date pickers
            dtpFromDate.Value = startOfYear
            dtpToDate.Value = endOfYear

            ' Load report
            LoadSalesReportByDateRange(startOfYear, endOfYear)

            ShowNotification($"Year Sales: {DateTime.Now.Year} (January to December)", "success")

        Catch ex As Exception
            MessageBox.Show("Error loading year sales: " & ex.Message)
        End Try
    End Sub
