    Private Sub btnDone_Click(sender As Object, e As EventArgs) Handles btnDone.Click

        If cartItems.Rows.Count = 0 Then
            ShowNotification("Cart is empty. Please add items first.", "warning")
            Return
        End If

        ' Check kung may laman ang txtReceiveMoney
        If txtReceiveMoney.Text = "" Or txtReceiveMoney.Text = "Enter amount received" Then
            ShowNotification("Please enter valid amount received", "warning")
            txtReceiveMoney.Focus()
            Return
        End If

        Dim amountPaid As Decimal = 0
        If Not Decimal.TryParse(txtReceiveMoney.Text, amountPaid) Or amountPaid <= 0 Then
            ShowNotification("Please enter valid amount received (numbers only)", "warning")
            txtReceiveMoney.Focus()
            Return
        End If

        If amountPaid < cartTotal Then
            ShowNotification($"Insufficient payment. Short by ₱{(cartTotal - amountPaid):N2}", "warning")
            txtReceiveMoney.Focus()
            Return
        End If

        Dim change As Decimal = amountPaid - cartTotal

        ' Automatic time - gamit ang system oras
        Dim saleTime As String = DateTime.Now.ToString("HH:mm:ss")
        Dim saleDate As String = DateTime.Now.ToString("yyyy-MM-dd")

        ' ===== GENERATE ORDER ID MUNA BAGO I-CONFIRM =====
        Using conTemp As New MySqlConnection(connString)
            conTemp.Open()
            Dim maxOrderID As Object = Nothing
            Using cmd As New MySqlCommand("SELECT MAX(OrderID) FROM sales", conTemp)
                maxOrderID = cmd.ExecuteScalar()
            End Using

            If maxOrderID Is DBNull.Value OrElse maxOrderID Is Nothing Then
                currentOrderID = 100001
            Else
                currentOrderID = Convert.ToInt32(maxOrderID) + 1
            End If
            conTemp.Close()
        End Using
        ' ===== END OF ORDER ID GENERATION =====

        ' ===== CONFIRM TRANSACTION =====
        Dim msg As String = ""
        msg &= "═══════════════════════════════════" & Environment.NewLine
        msg &= "      TRANSACTION SUMMARY" & Environment.NewLine
        msg &= "═══════════════════════════════════" & Environment.NewLine & Environment.NewLine

        For Each row As DataRow In cartItems.Rows
            Dim productName As String = row("ServiceType").ToString() & " (" & row("Size").ToString() & ")"
            Dim qty As Integer = Convert.ToInt32(row("Quantity"))
            Dim price As Decimal = Convert.ToDecimal(row("Price"))
            Dim total As Decimal = Convert.ToDecimal(row("Total"))

            msg &= $"{productName}" & Environment.NewLine
            msg &= String.Format("   x{0} @ ₱{1:N2}{2,30}₱{3:N2}", qty, price, "", total) & Environment.NewLine
        Next

        msg &= Environment.NewLine & "───────────────────────────────────" & Environment.NewLine
        msg &= String.Format("{0,-15} {1,33}", "TOTAL:", $"₱{cartTotal:N2}") & Environment.NewLine
        msg &= String.Format("{0,-15} {1,30}", "RECEIVED:", $"₱{amountPaid:N2}") & Environment.NewLine
        msg &= String.Format("{0,-15} {1,30}", "CHANGE:", $"₱{change:N2}") & Environment.NewLine & Environment.NewLine
        msg &= String.Format("{0,-15} {1,31}", "Date:", $"{DateTime.Now.ToString("yyyy-MM-dd")}") & Environment.NewLine
        msg &= String.Format("{0,-15} {1,31}", "Time:", $"{DateTime.Now.ToString("hh:mm:ss tt")}") & Environment.NewLine
        msg &= String.Format("{0,-15} {1,30}", "Order ID:", $"{currentOrderID}") & Environment.NewLine & Environment.NewLine
        msg &= New String(" ", 15) & "Save this transaction?"

        If MessageBox.Show(msg, "Confirm Transaction", MessageBoxButtons.OKCancel, MessageBoxIcon.Question) = DialogResult.No Then
            Return
        End If

        ' ===== I-SAVE SA DATABASE (YES ANG PININDOT) =====
        Try
            Using con As New MySqlConnection(connString)
                con.Open()

                For Each row As DataRow In cartItems.Rows
                    Dim cmd As New MySqlCommand("INSERT INTO Sales (ServiceType, Size, Quantity, Price, TotalAmount, SaleDate, SaleTime, AmountPaid, ChangeAmount, OrderID) VALUES (@ServiceType, @Size, @Quantity, @Price, @TotalAmount, @SaleDate, @SaleTime, @AmountPaid, @Change, @OrderID)", con)

                    cmd.Parameters.AddWithValue("@ServiceType", row("ServiceType").ToString())
                    cmd.Parameters.AddWithValue("@Size", row("Size").ToString())
                    cmd.Parameters.AddWithValue("@Quantity", Convert.ToInt32(row("Quantity")))
                    cmd.Parameters.AddWithValue("@Price", Convert.ToDecimal(row("Price")))
                    cmd.Parameters.AddWithValue("@TotalAmount", Convert.ToDecimal(row("Total")))
                    cmd.Parameters.AddWithValue("@SaleDate", saleDate)
                    cmd.Parameters.AddWithValue("@SaleTime", saleTime)
                    cmd.Parameters.AddWithValue("@AmountPaid", amountPaid)
                    cmd.Parameters.AddWithValue("@Change", change)
                    cmd.Parameters.AddWithValue("@OrderID", currentOrderID)

                    cmd.ExecuteNonQuery()
                Next
            End Using

            ' I-update ang Order ID label
            lblOrderId.Text = currentOrderID.ToString()

            ShowNotification($"✅ Transaction saved! Order ID: {currentOrderID}", "success")

            ' Clear cart
            cartItems.Clear()
            UpdateCartTotal()
            txtReceiveMoney.Text = "Enter amount received"
            txtReceiveMoney.ForeColor = Color.Gray
            lblChange.Text = "₱ 0.00"
            grpCart.Visible = False
            Timer1.Enabled = False
            lblRunningTime.Visible = False

            ' Refresh sales report
            LoadData()
            LoadSalesReportByDateRange(dtpFromDate.Value, dtpToDate.Value)

        Catch ex As Exception
            ShowNotification("Error: " & ex.Message, "error")
        End Try
    End Sub
