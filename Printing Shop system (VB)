    ' =========================
    ' Edit Sales Record
    ' =========================
    Private Sub BtnEdit_Click(sender As Object, e As EventArgs) Handles btnEdit.Click
        If selectedID = 0 Then
            MessageBox.Show("Please select a record to edit.")
            Exit Sub
        End If

        Try
            Dim total As Decimal = numQuantity.Value * Val(txtPrice.Text)
            con.Open()
            Dim query As String = "UPDATE Sales SET ServiceType=@ServiceType, Quantity=@Quantity, Price=@Price, TotalAmount=@TotalAmount, SaleDate=@SaleDate WHERE ID=@ID"
            Dim cmd As New MySqlCommand(query, con)
            cmd.Parameters.AddWithValue("@ServiceType", cmbServiceType.Text)
            cmd.Parameters.AddWithValue("@Quantity", numQuantity.Value)
            cmd.Parameters.AddWithValue("@Price", Val(txtPrice.Text))
            cmd.Parameters.AddWithValue("@TotalAmount", total)
            cmd.Parameters.AddWithValue("@SaleDate", dtpSaleDate.Value.ToString("yyyy-MM-dd"))
            cmd.Parameters.AddWithValue("@ID", selectedID)
            cmd.ExecuteNonQuery()
            con.Close()
            MessageBox.Show("Record Updated Successfully!")
            LoadData()
        Catch ex As Exception
            MessageBox.Show("Error: " & ex.Message)
            con.Close()
        End Try
    End Sub

