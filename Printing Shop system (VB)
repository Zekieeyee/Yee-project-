    ' Show floating notification
    Private Sub ShowNotification(message As String, msgType As String)
        Dim notif As New Form()
        notif.FormBorderStyle = FormBorderStyle.None
        notif.StartPosition = FormStartPosition.Manual
        notif.Location = New Point(Me.Location.X + (Me.Width - 300) \ 2, Me.Location.Y + Me.Height - 120)
        notif.Size = New Size(300, 50)
        notif.TopMost = True

        Select Case msgType
            Case "success"
                notif.BackColor = Color.FromArgb(0, 120, 0)
            Case "error"
                notif.BackColor = Color.FromArgb(180, 0, 0)
            Case "warning"
                notif.BackColor = Color.FromArgb(200, 100, 0)
            Case Else
                notif.BackColor = Color.FromArgb(50, 50, 50)
        End Select

        Dim lbl As New Label()
        lbl.Text = message
        lbl.ForeColor = Color.White
        lbl.Font = New Font("Segoe UI", 10, FontStyle.Bold)
        lbl.TextAlign = ContentAlignment.MiddleCenter
        lbl.Dock = DockStyle.Fill

        notif.Controls.Add(lbl)
        notif.Show()

        Dim t As New Timer()
        t.Interval = 2000
        AddHandler t.Tick, Sub(s, args)
                               notif.Close()
                               t.Stop()
                           End Sub
        t.Start()
    End Sub
