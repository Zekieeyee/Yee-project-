    Private Sub PrintReceiptDocument_PrintPage(sender As Object, e As PrintPageEventArgs) Handles PrintReceiptDocument.PrintPage
        Dim font As New Font("Courier New", 10)
        Dim boldFont As New Font("Courier New", 12, FontStyle.Bold)
        Dim y As Integer = 50
        Dim x As Integer = 50

        e.Graphics.DrawString("PRINTING SHOP", boldFont, Brushes.Black, x, y)
        y += 25
        e.Graphics.DrawString("SALES RECEIPT", font, Brushes.Black, x, y)
        y += 25
        e.Graphics.DrawString("Date: " & DateTime.Now.ToString("yyyy-MM-dd"), font, Brushes.Black, x, y)
        y += 20
        e.Graphics.DrawString("Time: " & lblRunningTime.Text(), font, Brushes.Black, x, y)
        y += 25
        e.Graphics.DrawString("Order ID: " & currentOrderID.ToString(), font, Brushes.Black, x, y)
        y += 25

        e.Graphics.DrawString(New String("-", 40), font, Brushes.Black, x, y)
        y += 20

        For Each row As DataRow In cartItems.Rows
            Dim itemText As String = row("ServiceType").ToString() & " (" & row("Size").ToString() & ")"
            e.Graphics.DrawString(itemText, font, Brushes.Black, x, y)
            y += 18

            Dim qtyText As String = "  x" & row("Quantity").ToString() & " @ ₱" & Convert.ToDecimal(row("Price")).ToString("N2")
            e.Graphics.DrawString(qtyText, font, Brushes.Black, x + 10, y)

            Dim totalText As String = "₱" & Convert.ToDecimal(row("Total")).ToString("N2")
            e.Graphics.DrawString(totalText, font, Brushes.Black, x + 200, y)
            y += 20
        Next

        e.Graphics.DrawString(New String("-", 40), font, Brushes.Black, x, y)
        y += 20

        e.Graphics.DrawString("TOTAL:", boldFont, Brushes.Black, x, y)
        e.Graphics.DrawString("₱" & cartTotal.ToString("N2"), boldFont, Brushes.Black, x + 200, y)
        y += 20

