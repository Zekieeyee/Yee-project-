    Private Sub ComputeTotal()
        If IsNumeric(txtPrice.Text) Then
            Dim total As Decimal = numQuantity.Value * Convert.ToDecimal(txtPrice.Text)
        End If
    End Sub

    Private Sub ComputeReportTotal(dt As DataTable)
        Dim totalSales As Decimal = 0
        For Each row As DataRow In dt.Rows
            totalSales += Convert.ToDecimal(row("TotalAmount"))
        Next
    End Sub

    ' =========================
    ' Get Price for Service/Size
    ' =========================
    Private Sub GetPrice()

        If cmbServiceType.Text = "" Or cmbSize.Text = "" Then
            txtPrice.Clear()
            Exit Sub
        End If

        Try
            If con.State = ConnectionState.Open Then con.Close()

            Dim service As String = cmbServiceType.Text.Trim()

            If service = "Type of Service" Then
                txtPrice.Clear()
                Exit Sub
            End If



            Dim cmd As New MySqlCommand("SELECT Price FROM Prices WHERE ServiceType=@service AND Size=@size", con)

            cmd.Parameters.AddWithValue("@service", service)
            cmd.Parameters.AddWithValue("@size", cmbSize.Text.Trim())

            con.Open()

            Dim result = cmd.ExecuteScalar()

            If result IsNot Nothing AndAlso Not IsDBNull(result) Then
                txtPrice.Text = Convert.ToDecimal(result).ToString("0.00")
            Else
                txtPrice.Text = "0.00"
            End If

            con.Close()

        Catch ex As Exception
            MessageBox.Show(ex.Message)
            If con.State = ConnectionState.Open Then con.Close()
        End Try

    End Sub

