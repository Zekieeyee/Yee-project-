    ' Placeholder / Indicator para sa TextBox
    Private Sub SetPlaceholder(txt As TextBox, placeholderText As String)
        txt.Text = placeholderText
        txt.ForeColor = Color.Gray
        txt.Tag = placeholderText

        AddHandler txt.Enter, Sub(sender As Object, e As EventArgs)
                                  Dim tb As TextBox = DirectCast(sender, TextBox)
                                  If tb.Text = tb.Tag.ToString() Then
                                      tb.Text = ""
                                      tb.ForeColor = Color.Black
                                  End If
                              End Sub

        AddHandler txt.Leave, Sub(sender As Object, e As EventArgs)
                                  Dim tb As TextBox = DirectCast(sender, TextBox)
                                  If String.IsNullOrWhiteSpace(tb.Text) Then
                                      tb.Text = tb.Tag.ToString()
                                      tb.ForeColor = Color.Gray
                                  End If
                              End Sub
    End Sub
